} else {
  prompt_requests <- tibble()
}

if (is.null(missing_column_message)) {
  duplicate_request_keys <- prompt_requests %>%
    count(case_id, model_type, provider, repeat_id, name = "n") %>%
    filter(n > 1)
} else {
