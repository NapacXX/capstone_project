}

if (is.null(missing_column_message) && nrow(duplicate_request_keys) > 0) {
  stop("Duplicate case_id + model_type + provider + repeat_id combinations were found in the request input.")
}

if (is.null(missing_column_message)) {
  prompt_requests <- prompt_requests %>%
    select(any_of(c("case_id", "vignette_text", "prompt_text", "model_type", "provider", "repeat_id", "prompt_type"))) %>%
