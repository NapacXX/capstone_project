# Input Preparation

```{r load-and-prepare}
raw_data <- read_csv(prompt_input_path, show_col_types = FALSE)

blank_names <- names(raw_data) == ""
if (any(blank_names)) {
  names(raw_data)[blank_names] <- paste0("blank_column_", seq_len(sum(blank_names)))
}

missing_columns <- setdiff(required_input_columns, names(raw_data))

if (length(missing_columns) > 0) {
  template_example <- tibble(
    case_id = c("DM020", "DM020"),
    vignette_text = c("Optional source vignette text.", "Optional source vignette text."),
    prompt_text = c("Paste the full prompt to send to the model.", "Paste the full prompt to send to the model."),
    model_type = c("gpt-5.4", "claude-opus-4-20250514")
  )

  missing_column_message <- paste(
    "The input file is missing required columns:",
    paste(missing_columns, collapse = ", ")
  )
} else {
  missing_column_message <- NULL
}

if (is.null(missing_column_message)) {
  raw_data <- raw_data %>%
    mutate(
      case_id = as.character(case_id),
      prompt_text = as.character(prompt_text),
      model_type = as.character(model_type)
    )
}

if (is.null(missing_column_message)) {
  if (!"prompt_type" %in% names(raw_data)) {
    raw_data <- raw_data %>%
      mutate(prompt_type = configured_prompt_type)
  } else {
    raw_data <- raw_data %>%
      mutate(prompt_type = dplyr::coalesce(as.character(prompt_type), configured_prompt_type))
  }
}

if (is.null(missing_column_message)) {
  blank_prompt_rows <- raw_data %>%
    filter(is.na(prompt_text) | !nzchar(str_squish(prompt_text)))
} else {
  blank_prompt_rows <- tibble()
}

if (is.null(missing_column_message) && nrow(blank_prompt_rows) > 0) {
  stop("Some rows have blank prompt_text values. Clean the input file before running generation.")
}

if (is.null(missing_column_message)) {
  if ("repeat_id" %in% names(raw_data)) {
    prompt_requests <- raw_data %>%
      mutate(repeat_id = suppressWarnings(as.integer(repeat_id))) %>%
      arrange(case_id, model_type, provider, repeat_id)

