# Generation

```{r generation}
repeated_outputs_tbl <- tibble()
repeated_outputs_list <- list()

if (run_generation) {
  validate_configuration(
    api_key = api_key,
    base_url = base_url,
    n_repeats = n_repeats
  )

  if (is.na(detect_provider_from_url(base_url))) {
    stop("base_url must point to a supported OpenAI or Anthropic endpoint before running generation.")
  }

  missing_model_rows <- request_grid %>%
    filter(is.na(model_type) | !nzchar(str_squish(model_type)))

  if (nrow(missing_model_rows) > 0) {
    stop("Some rows have blank model_type values.")
  }

  repeated_outputs_tbl <- pmap_dfr(
    request_grid,
    function(case_id, prompt_text, model_type, provider, repeat_id, prompt_type, ...) {
      result <- tryCatch(
        {
          response_text <- generate_treatment_plan(
            prompt_text = prompt_text,
            provider = provider,
            model_id = model_type,
            api_key = api_key,
            base_url = base_url,
            temperature = temperature,
            max_output_tokens = max_output_tokens
          )

          tibble(
            case_id = case_id,
            model_type = model_type,
            provider = provider,
            prompt_type = prompt_type,
            repeat_id = repeat_id,
            temperature = temperature,
            treatment_plan = response_text,
            error_message = ""
          )
        },
        error = function(e) {
          tibble(
            case_id = case_id,
            model_type = model_type,
            provider = provider,
            prompt_type = prompt_type,
            repeat_id = repeat_id,
            temperature = temperature,
            treatment_plan = "",
            error_message = conditionMessage(e)
          )
        }
      )

      Sys.sleep(request_pause_seconds)
      result
    }
  )

  repeated_outputs_list <- split(repeated_outputs_tbl, repeated_outputs_tbl$case_id)
}
```

# Validation

```{r post-generation-validation}
if (run_generation) {
  expected_rows <- nrow(request_grid)
  actual_rows <- nrow(repeated_outputs_tbl)

  duplicate_keys <- repeated_outputs_tbl %>%
    count(case_id, model_type, provider, repeat_id, name = "n") %>%
    filter(n > 1)

  repeat_check <- repeated_outputs_tbl %>%
    group_by(case_id, model_type, provider) %>%
    summarise(
      observed_repeats = paste(sort(unique(repeat_id)), collapse = ","),
      n_rows = n(),
      .groups = "drop"
    )

  validation_summary <- tibble(
    check = c(
      "Expected rows",
      "Actual rows",
      "Duplicate case_id + model_type + provider + repeat_id keys",
      "Non-empty treatment_plan rows",
      "Rows with error_message"
    ),
    value = c(
      expected_rows,
      actual_rows,
      nrow(duplicate_keys),
      sum(nzchar(repeated_outputs_tbl$treatment_plan)),
      sum(nzchar(repeated_outputs_tbl$error_message))
    )
  )

  validation_summary %>% kable()

  generated_preview_n <- min(5, nrow(repeated_outputs_tbl))
  error_preview_n <- min(10, nrow(filter(repeated_outputs_tbl, nzchar(error_message))))

  if (actual_rows != expected_rows) {
    stop("Generated row count does not match expected_rows.")
  }

  if (nrow(duplicate_keys) > 0) {
    stop("Duplicate case_id + model_type + provider + repeat_id combinations detected in repeated_outputs_tbl.")
  }

  if (sum(nzchar(repeated_outputs_tbl$treatment_plan)) == 0) {
    stop("All generated treatment_plan values are blank. Check credentials, base_url, and model_id.")
  }

  repeated_outputs_tbl %>%
    select(case_id, model_type, provider, repeat_id, treatment_plan, error_message) %>%
    slice_head(n = generated_preview_n) %>%
    mutate(treatment_plan = str_trunc(treatment_plan, 180)) %>%
    kable(caption = "Preview of generated outputs")

  repeated_outputs_tbl %>%
    filter(nzchar(error_message)) %>%
    slice_head(n = error_preview_n) %>%
    mutate(error_message = str_trunc(error_message, 180)) %>%
    kable(caption = "Preview of API failures, if any")
}
```

# Export

```{r export}
if (run_generation) {
  resolved_output_path <- output_path
  if (is.null(resolved_output_path)) {
    resolved_output_path <- file.path(
      "data/processed",
      paste0("intra_model_consistency_", provider, "_", safe_model_id(model_id), ".csv")
    )
  }

  if (file.exists(resolved_output_path) && !overwrite_existing) {
    stop("Output file already exists and overwrite_existing is FALSE: ", resolved_output_path)
  }

  write_csv(repeated_outputs_tbl, resolved_output_path)

  tibble(
    output = c("Results CSV", "In-memory tibble", "Split list by case_id"),
    value = c(
      resolved_output_path,
      "repeated_outputs_tbl",
      "repeated_outputs_list"
    )
  ) %>%
    kable()
}
```

