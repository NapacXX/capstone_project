# API Helpers

```{r api-helpers}
validate_configuration <- function(api_key, base_url, n_repeats) {
  if (!is.character(api_key) || !nzchar(api_key)) {
    stop("api_key is blank. Paste a valid API key into the configuration section.")
  }
  if (!is.character(base_url) || !nzchar(base_url)) {
    stop("base_url is blank. Set the provider endpoint in the configuration section.")
  }
  if (!is.numeric(n_repeats) || length(n_repeats) != 1 || n_repeats < 1) {
    stop("n_repeats must be a positive integer.")
  }
}

detect_provider_from_url <- function(base_url) {
  url_lower <- str_to_lower(base_url)

  if (!nzchar(str_squish(url_lower))) {
    return(NA_character_)
  }

  if (str_detect(url_lower, "openai\\.com")) {
    return("openai")
  }

  if (str_detect(url_lower, "anthropic\\.com")) {
    return("anthropic")
  }

  stop("Unsupported base_url. This file only supports OpenAI and Anthropic endpoints.")
}

extract_openai_text <- function(body) {
  if (!is.null(body$output_text) && nzchar(body$output_text)) {
    return(body$output_text)
  }

  if (!is.null(body$output) && length(body$output) > 0) {
    content_text <- unlist(
      purrr::map(
        body$output,
        function(item) {
          if (!is.null(item$content)) {
            unlist(
              purrr::map(
                item$content,
                function(content_item) {
                  if (!is.null(content_item$text)) {
                    content_item$text
                  } else if (!is.null(content_item$`text`)) {
                    content_item$`text`
                  } else {
                    NULL
                  }
                }
              )
            )
          } else {
            NULL
          }
        }
      )
    )

    if (length(content_text) > 0) {
      return(paste(content_text, collapse = "\n"))
    }
  }

  ""
}

extract_anthropic_text <- function(body) {
  if (!is.null(body$content) && length(body$content) > 0) {
    text_parts <- unlist(
      purrr::map(
        body$content,
        function(item) if (!is.null(item$text)) item$text else NULL
      )
    )
    if (length(text_parts) > 0) {
      return(paste(text_parts, collapse = "\n"))
    }
  }

  ""
}

call_openai_response <- function(prompt_text, model_id, api_key, base_url, temperature, max_output_tokens) {
  body <- list(
    model = model_id,
    input = list(
      list(
        role = "user",
        content = prompt_text
      )
    ),
    temperature = temperature,
    text = list(
      format = list(type = "text")
    ),
    max_output_tokens = max_output_tokens
  )

  response <- request(base_url) %>%
    req_headers(
      Authorization = paste("Bearer", api_key),
      `Content-Type` = "application/json"
    ) %>%
    req_body_json(body, auto_unbox = TRUE) %>%
    req_perform()

  parsed <- resp_body_json(response, simplifyVector = FALSE)
  extract_openai_text(parsed)
}

call_anthropic_response <- function(prompt_text, model_id, api_key, base_url, temperature, max_output_tokens) {
  body <- list(
    model = model_id,
    max_tokens = max_output_tokens,
    temperature = temperature,
    messages = list(
      list(
        role = "user",
        content = prompt_text
      )
    )
  )

  response <- request(base_url) %>%
    req_headers(
      `x-api-key` = api_key,
      `anthropic-version` = "2023-06-01",
      `content-type` = "application/json"
    ) %>%
    req_body_json(body, auto_unbox = TRUE) %>%
    req_perform()

  parsed <- resp_body_json(response, simplifyVector = FALSE)
  extract_anthropic_text(parsed)
}

generate_treatment_plan <- function(prompt_text, provider, model_id, api_key, base_url, temperature, max_output_tokens) {
  if (provider == "openai") {
    return(call_openai_response(
      prompt_text = prompt_text,
      model_id = model_id,
      api_key = api_key,
      base_url = base_url,
      temperature = temperature,
      max_output_tokens = max_output_tokens
    ))
  }

  if (provider == "anthropic") {
    return(call_anthropic_response(
      prompt_text = prompt_text,
      model_id = model_id,
      api_key = api_key,
      base_url = base_url,
      temperature = temperature,
      max_output_tokens = max_output_tokens
    ))
  }

  stop("Unsupported provider: ", provider)
}

safe_model_id <- function(x) {
  x %>%
    str_replace_all("[^A-Za-z0-9]+", "_") %>%
    str_replace_all("^_+|_+$", "")
}
```

